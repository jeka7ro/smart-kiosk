# POS Bridge — Config
RENDER_URL=https://smart-kiosk-ttut.onrender.com

# Port serial COM (USB-Serial adapter). Pune ex: COM3, COM4
# Lasa 'auto' pentru detectare automata
COM_PORT=auto
BAUD_RATE=9600

LOCATION_ID=brasov
BRIDGE_KEY=pos-bridge-2024

# Gateway POS: 'raiffeisen' (default, cu cablu COM) sau 'viva_pos' (prin IP)
POS_GATEWAY=raiffeisen

# Setari Viva POS (Valabile doar daca POS_GATEWAY=viva_pos)
VIVA_POS_IP=192.168.20.113
VIVA_POS_PORT=8080

# Imprimanta Datecs FP950 pe Serial (daca nu se foloseste printerul standard din Windows)
# Daca folositi direct din Windows, lasati gol si folositi PRINTER_NAME mai sus
DATECS_COM_PORT=
DATECS_BAUD_RATE=9600
