# POS Bridge — Config
RENDER_URL=https://smart-kiosk-ttut.onrender.com

# Port serial COM (USB-Serial adapter). Pune ex: COM3, COM4
# Lasa 'auto' pentru detectare automata
COM_PORT=auto
BAUD_RATE=9600

LOCATION_ID=brasov
BRIDGE_KEY=pos-bridge-2024

# Gateway POS (Raiffeisen ECR prin cablu COM serial)
POS_GATEWAY=raiffeisen

# ==============================================================================
# CONFIGURARE IMPRIMANTA (specifica fiecarei locatii)
# ==============================================================================
# Optiunea 1: Imprimanta Windows standard (Epson, Citizen, etc. prin driver USB/Windows)
PRINTER_NAME=EPSON TM-T20II Receipt

# Optiunea 2: Imprimanta Datecs FP950 pe port serial COM (ex: in Constanta)
# Daca locatia foloseste Datecs, completati portul COM. Daca foloseste Epson, lasati gol.
DATECS_COM_PORT=
DATECS_BAUD_RATE=9600
